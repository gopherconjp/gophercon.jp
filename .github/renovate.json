{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "conflicted",
  "gitIgnoredAuthors": ["114827586+autofix-ci[bot]@users.noreply.github.com"],
  "packageRules": [
    {
      "description": "Keep all the Penpot images in lockstep",
      "matchManagers": ["docker-compose"],
      "matchDepNames": ["penpotapp/*"],
      "groupName": "Penpot (docker compose)"
    },
    {
      "description": "Keep intlayer packages in lockstep",
      "matchDepNames": ["intlayer", "astro-intlayer", "@intlayer/*"],
      "groupName": "intlayer"
    }
  ]
}
