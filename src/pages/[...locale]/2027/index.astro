---
import {
  getDictionary,
  getLocaleFromPath,
  getPrefix,
  localeMap,
  t,
  type Dictionary,
  type LocalesValues,
} from "intlayer";
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";

export const getStaticPaths = () =>
  localeMap(({ locale }) => ({
    params: { locale: getPrefix(locale).localePrefix },
  }));

const content = {
  key: "local",
  content: {
    title: t({
      en: "GopherCon Japan",
      ja: "GopherCon Japan",
    }),
    description: t({
      en: "GopherCon Japan Official Website",
      ja: "GopherCon Japan 公式ウェブサイト",
    }),
    missionTitle: t({
      en: "Our Mission",
      ja: "私たちのミッション",
    }),
    mission: t({
      en: "Let the world's passion reach Japan. Let Japan's untapped wisdom travel to the world.",
      ja: "世界の情熱を日本へ。日本の未発見の叡智を世界へ。",
    }),
  },
} satisfies Dictionary;

const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const { title, description, missionTitle, mission } = getDictionary(
  content,
  locale,
);
---

<Layout title={title} description={description}>
  <Hero locale={locale} />
  <section class="mission">
    <h2 class="mission__title">{missionTitle}</h2>
    <p class="mission__statement">{mission}</p>
  </section>
</Layout>

<style>
  .mission {
    max-width: 40rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    text-align: center;
  }

  .mission__title {
    margin: 0 0 1rem;
    font-size: 1.5rem;
  }

  .mission__statement {
    margin: 0;
    color: #555;
    line-height: 1.9;
  }
</style>
