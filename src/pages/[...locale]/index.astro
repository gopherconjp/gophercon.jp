---
import {
  getLocaleFromPath,
  getLocalizedUrl,
  getPrefix,
  localeMap,
  type LocalesValues,
} from "intlayer";

import Layout from "../../components/index/_layouts/Layout.astro";

const mainPath = "/2027";

export const getStaticPaths = () => {
  return localeMap(({ locale }) => ({
    params: { locale: getPrefix(locale).localePrefix },
  }));
};

const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const destination = getLocalizedUrl(mainPath, locale);
---

<Layout redirectTo={destination} noindex>
  <p>
    Redirecting to <a href={destination}>{destination}</a>
  </p>
</Layout>
