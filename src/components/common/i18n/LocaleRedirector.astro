<script>
  import { localeStorageOptions } from "@intlayer/core/utils";
  import {
    defaultLocale,
    getBrowserLocale,
    getLocaleFromPath,
    getLocalizedUrl,
    getPathWithoutLocale,
    locales,
    setLocaleInStorageClient,
    type LocalesValues,
  } from "intlayer";

  const currentLocale = getLocaleFromPath(
    window.location.pathname,
  ) as LocalesValues;

  const browserLocale = getBrowserLocale();
  const targetLocale = locales.includes(browserLocale)
    ? browserLocale
    : defaultLocale;

  if (targetLocale !== currentLocale) {
    setLocaleInStorageClient(targetLocale, localeStorageOptions);

    window.location.replace(
      getLocalizedUrl(
        getPathWithoutLocale(window.location.pathname),
        targetLocale,
      ),
    );
  }
</script>
