---
import type { LocalesValues } from "intlayer";

import { isAccent, isLink, type Breakable } from "./types";

interface Props {
  value: Breakable;
  locale: LocalesValues;
}
const { value, locale } = Astro.props;

const separator = locale === "ja" ? "" : " ";
---

{Array.isArray(value) ? (
  value.map((chunk, index) => (
    <>
      {index > 0 ? separator : null}
      <span class="breakable__chunk">
        <Astro.self value={chunk} locale={locale} />
      </span>
    </>
  ))
) : isAccent(value) ? (
  <span class="breakable__accent">
    <Astro.self value={value.accent} locale={locale} />
  </span>
) : isLink(value) ? (
  <a href={value.href}>
    <Astro.self value={value.link} locale={locale} />
  </a>
) : typeof value === "string" ? (
  value.split(/\r?\n/).map((line, index) => (
    <>
      {index > 0 ? <br /> : null}
      {line}
    </>
  ))
) : null}

<style>
  .breakable__chunk {
    display: inline-block;
  }

  .breakable__accent {
    color: var(--_color-accent);
  }
</style>
