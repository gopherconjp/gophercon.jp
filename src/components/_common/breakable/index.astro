---
import { escape } from "html-escaper";

import { isAccent, isBreak, isLink, type Breakable } from "./types";

interface Props {
  value: Breakable;
  space?: boolean;
}
const { value, space = true } = Astro.props;

const separator = space ? " " : "";

const containsBreak = (node: Breakable): boolean => {
  if (Array.isArray(node)) {
    return node.some(containsBreak);
  }

  return isBreak(node);
};

const render = (node: Breakable): string => {
  if (Array.isArray(node)) {
    const inner = node
      .map((chunk, index) => (index > 0 ? separator : "") + render(chunk))
      .join("");

    return containsBreak(node)
      ? inner
      : `<span class="breakable__chunk">${inner}</span>`;
  }

  if (isBreak(node)) {
    return "<br />";
  }

  if (isAccent(node)) {
    return `<span class="breakable__accent">${render(node.accent)}</span>`;
  }

  if (isLink(node)) {
    return `<a href="${escape(node.href)}">${render(node.link)}</a>`;
  }

  if (typeof node === "string") {
    return `<span class="breakable__chunk">${escape(node)}</span>`;
  }

  return "";
};
---

<Fragment set:html={render(value)} />

<style is:global>
  .breakable__chunk {
    display: inline-block;
  }

  .breakable__accent {
    color: var(--_color-accent);
    font-weight: var(--_font-weight-bold);
  }
</style>
