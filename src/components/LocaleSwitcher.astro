---
import {
  getDictionary,
  getLocaleName,
  getLocalizedUrl,
  getPathWithoutLocale,
  locales,
  t,
  type Dictionary,
  type LocalesValues,
} from "intlayer";

interface Props {
  locale: LocalesValues;
}
const { locale } = Astro.props;

const pathWithoutLocale = getPathWithoutLocale(Astro.url.pathname);

const content = {
  key: "local",
  content: {
    ariaLabel: t({
      en: "Change language",
      ja: "言語を切り替える",
    }),
  },
} satisfies Dictionary;
const { ariaLabel } = getDictionary(content, locale);
---

<nav
  class="locale-switcher"
  aria-label={ariaLabel}
  data-current-locale={locale}
>
  <ul>
    {
      locales.map((item: LocalesValues) => (
        <li>
          <a
            href={getLocalizedUrl(pathWithoutLocale, item)}
            data-locale={item}
            aria-current={item === locale ? "page" : undefined}
          >
            {getLocaleName(item)}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import { localeStorageOptions } from "@intlayer/core/utils";
  import {
    getBrowserLocale,
    setLocaleInStorageClient,
    type LocalesValues,
  } from "intlayer";

  const nav = document.querySelector<HTMLElement>(".locale-switcher");
  const currentLocale = nav?.dataset.currentLocale as LocalesValues | undefined;

  const browserLocale = getBrowserLocale();
  if (currentLocale && browserLocale !== currentLocale) {
    setLocaleInStorageClient(browserLocale, localeStorageOptions);

    const link = nav?.querySelector<HTMLAnchorElement>(
      `[data-locale="${browserLocale}"]`,
    );
    if (link) {
      window.location.replace(link.href);
    }
  }

  document.querySelectorAll("[data-locale]").forEach((link) => {
    link.addEventListener("click", () => {
      const targetLocale = link.getAttribute("data-locale") as LocalesValues;
      if (targetLocale) {
        setLocaleInStorageClient(targetLocale, localeStorageOptions);
      }
    });
  });
</script>

<style>
  .locale-switcher ul {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a[aria-current="page"] {
    font-weight: bold;
    text-decoration: underline;
  }
</style>
