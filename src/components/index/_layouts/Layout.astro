---
import {
  defaultLocale,
  getHTMLTextDir,
  getLocaleFromPath,
  getLocalizedUrl,
  getPathWithoutLocale,
  localeMap,
  type LocalesValues,
} from "intlayer";

import LocaleRedirector from "../../_common/LocaleRedirector.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
  redirectTo?: string;
}

const {
  title = "",
  description,
  image = "/index/ogp.png",
  imageAlt = "GopherCon Japan OGP",
  type = "website",
  noindex = false,
  redirectTo,
} = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const pathWithoutLocale = getPathWithoutLocale(Astro.url.pathname);

const SITE_NAME = "GopherCon Japan";
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;

const ogImage = new URL(image, Astro.site);
const OG_LOCALES: Record<LocalesValues, string> = {
  en: "en_US",
  ja: "ja_JP",
};
const ogLocale = OG_LOCALES[locale];

const canonical = new URL(
  redirectTo ?? getLocalizedUrl(pathWithoutLocale, locale),
  Astro.site,
);

const alternates = localeMap(({ locale: alternateLocale }) => ({
  locale: alternateLocale,
  href: new URL(
    getLocalizedUrl(pathWithoutLocale, alternateLocale),
    Astro.site,
  ),
}));

const xDefaultHref = new URL(
  getLocalizedUrl(pathWithoutLocale, defaultLocale),
  Astro.site,
);
---

<!doctype html>
<html lang={locale} dir={getHTMLTextDir(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FF7A65" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon/favicon-16x16.png"
    />
    <link rel="icon" href="/favicon/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    {
      alternates
        .filter((alt) => OG_LOCALES[alt.locale] !== ogLocale)
        .map((alt) => (
          <meta
            property="og:locale:alternate"
            content={OG_LOCALES[alt.locale]}
          />
        ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@GopherConJP" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.locale} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    {
      redirectTo && (
        <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
      )
    }
    <slot name="head" />
    <LocaleRedirector />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
