---
import { Image } from "astro:assets";

import Layout from "../_layouts/Layout.astro";
import Breakable from "../../_common/breakable/index.astro";
import ContentBox from "../../_common/content-box/index.astro";
import illust from "./404.webp";
---

<Layout locale="en" title="404" description="404 - Page not found" noindex>
  <section class="not-found">
    <ContentBox>
      <div class="not-found__content">
        <Image
          src={illust}
          alt="Confused Gopher illustration"
          width={500}
          height={500}
          class="not-found__image"
          loading="eager"
          fetchpriority="high"
        />
        <div class="not-found__text">
          <h1 class="not-found__heading">404</h1>
          <p class="not-found__body">
            <span lang="ja">
              <Breakable
                value={["お探しのページは", "見つかりませんでした。"]}
                space={false}
              />
            </span>
            <br />
            <Breakable
              value={[["The page", "you are looking for"], "does not exist."]}
            />
            <br />
            <a href="/" data-back>
              <span lang="ja">戻る</span> / Back
            </a>
          </p>
        </div>
      </div>
    </ContentBox>
  </section>
</Layout>

<script>
  document.querySelector("a[data-back]")?.addEventListener("click", (event) => {
    if (history.length > 1) {
      event.preventDefault();
      history.back();
    }
  });
</script>

<style>
  .not-found__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--_spacing-32);
    padding: var(--_spacing-64) 0;
    text-align: center;
  }

  .not-found__body {
    margin: 0;
  }

  .not-found__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--_spacing-16);
  }

  .not-found__image {
    width: min(100%, 500px);
    height: auto;
  }
</style>
