---
import { getIntlayer, type LocalesValues } from "intlayer";

import Layout from "../_layouts/Layout.astro";

interface Props {
  locale: LocalesValues;
}
const { locale } = Astro.props;
const { title, description, heading, body } = getIntlayer("not-found", locale);
---

<Layout locale={locale} title={title} description={description} noindex>
  <section class="not-found">
    <h1>{heading}</h1>
    <p>{body}</p>
  </section>
</Layout>

<style>
  .not-found {
    max-width: 40rem;
    margin: 0 auto;
    padding: 6rem 1rem;
    text-align: center;
  }
</style>
