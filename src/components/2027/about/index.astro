---
import { getIntlayer, type LocalesValues } from "intlayer";

import PageBanner from "../_common/page-banner/index.astro";
import Layout from "../_layouts/Layout.astro";
import Section1 from "./Section1.astro";
import Section2 from "./Section2.astro";
import Section3 from "./Section3.astro";

interface Props {
  locale: LocalesValues;
}
const { locale } = Astro.props;

const { description, bannerTitleJa, bannerTitleEn } = getIntlayer(
  "2027-about",
  locale,
);
---

<Layout locale={locale} description={description}>
  <PageBanner titleJa={bannerTitleJa} titleEn={bannerTitleEn} />
  <Section1 locale={locale} />
  <Section2 locale={locale} />
  <Section3 locale={locale} />
</Layout>
