---
import {
  getDictionary,
  t,
  type Dictionary,
  type LocalesValues,
} from "intlayer";

import background from "./background.webp";
import cloudL from "./cloud_l.webp";
import cloudR from "./cloud_r.webp";
import hikyaku from "./hikyaku.webp";
import logo from "./logo.webp";
import onago from "./onago.webp";
import rectangle from "./rectangle.webp";
import samurai from "./samurai.webp";
import warabe from "./warabe.webp";

interface Props {
  locale: LocalesValues;
}
const { locale } = Astro.props;

const content = {
  key: "local",
  content: {
    ariaLabel: t({
      en: "GopherCon Japan 2027 key visual",
      ja: "GopherCon Japan 2027 キービジュアル",
    }),
  },
} satisfies Dictionary;
const { ariaLabel } = getDictionary(content, locale);

// Stage layers in stacking order (bottom → top).
const layers: {
  class: string;
  src: string;
  width?: number;
  priority?: boolean;
}[] = [
  { class: "kv__cloud kv__cloud--l", src: cloudL.src },
  { class: "kv__cloud kv__cloud--r", src: cloudR.src, priority: true },
  { class: "kv__hikyaku", src: hikyaku.src },
  { class: "kv__onago", src: onago.src },
  { class: "kv__warabe", src: warabe.src },
  { class: "kv__rectangle", src: rectangle.src, width: 1530 },
  { class: "kv__logo", src: logo.src, priority: true },
  { class: "kv__samurai", src: samurai.src },
];
---

{
  /*
  Responsive key visual (container width W):
  - W >= 1350px: frame fixed at 1350x900
  - 700px <= W < 1350px: width shrinks, height 900 (layers move)
  - W < 700px: whole composition scales by W/700
*/
}
<div class="kv" role="img" aria-label={ariaLabel}>
  <img
    class="kv__background"
    src={background.src}
    width={1350}
    height={900}
    alt=""
    aria-hidden="true"
    fetchpriority="high"
    decoding="async"
  />
  <div class="kv__stage">
    {
      layers.map((l) => (
        <img
          class={l.class}
          src={l.src}
          width={l.width ?? 1350}
          height={900}
          alt=""
          aria-hidden="true"
          decoding="async"
          fetchpriority={l.priority ? "high" : undefined}
        />
      ))
    }
  </div>
</div>

<style>
  .kv {
    /* Tunable design tokens.
       Convention: `--_`-prefixed names are build-time constants inlined by
       lightningcss-plugin-css-variables (default include /^--_/). */
    --_kv-max: 1350px; /* max frame width */
    --_kv-break: 700px; /* below this, composition scales down */
    --_kv-cloud-l-turn: 1150px; /* cloud_l starts receding below this */
    --_kv-cloud-l-hide: 900px; /* cloud_l fully hidden below this */
    --_kv-onago-x: 60px; /* onago content left edge at W = break */

    --_kv-cloud-swing-period: 6s; /* cloud wiggle period */
    --_kv-cloud-swing-amp: 24px; /* cloud wiggle width (total travel) */

    --kv-shrink: calc(
      (var(--_kv-max) - var(--_kv-break)) / 2
    ); /* per-edge frame shrink */

    /* Phase-2 progress (0..1); stays 1 below break */
    --t: clamp(
      0,
      (var(--_kv-max) - 100cqw) / (var(--_kv-max) - var(--_kv-break)),
      1
    );

    container-type: inline-size;
    position: relative;
    width: min(100%, var(--_kv-max));
    margin: 0 auto;
    /* 700:900 ratio; height 900px in phases 1-2, proportional in phase 3 */
    aspect-ratio: calc(var(--_kv-break) / 900px);
    max-height: 900px;
    overflow: hidden;
  }

  /* Covers the frame, center-cropped.
     width/height required: an absolutely positioned img keeps its intrinsic size
     without them, so inset: 0 alone would pin it to the top-left. */
  .kv__background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(0.99); /* avoid subpixel gaps at edges */
  }

  /* 1350x900 design space, centered; scales the whole composition when W < break */
  .kv__stage {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--_kv-max);
    height: 900px;
    transform: translate(-50%, -50%)
      scale(min(1, calc(100cqw / var(--_kv-break))));
  }

  /* Shared stage-img base.
     Sizing is read from per-layer custom properties (--kv-left / --kv-width) instead of
     being overridden directly: Astro scopes this selector with [data-astro-cid] attributes,
     which adds specificity and would beat `.kv__rectangle`'s direct left/width. */
  .kv__stage :where(img) {
    position: absolute;
    top: 0;
    left: var(--kv-left, 0);
    width: var(--kv-width, var(--_kv-max));
    height: 900px;
  }

  .kv__cloud {
    z-index: 1;
    animation: kv-cloud-swing var(--_kv-cloud-swing-period) ease-in-out infinite;
  }

  @keyframes kv-cloud-swing {
    0%,
    100% {
      transform: translateX(
        calc(var(--kv-cloud-x) - var(--_kv-cloud-swing-amp) / 2)
      );
    }
    50% {
      transform: translateX(
        calc(var(--kv-cloud-x) + var(--_kv-cloud-swing-amp) / 2)
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kv__cloud {
      animation: none;
    }
  }

  /* cloud_l: pinned to the frame's left edge above --_kv-cloud-l-turn, then recedes
     (eased) to fully hidden at --_kv-cloud-l-hide.
     Recession = cloud width − per-edge shrink over turn..hide, so its right edge
     clears the frame at hide. */
  .kv__cloud--l {
    /* recession progress (0 at turn, 1 at hide) */
    --t-cloud-l: clamp(
      0,
      (var(--_kv-cloud-l-turn) - 100cqw) /
        (var(--_kv-cloud-l-turn) - var(--_kv-cloud-l-hide)),
      1
    );
    /* smoothstep easing */
    --t-cloud-l-eased: calc(
      var(--t-cloud-l) * var(--t-cloud-l) * (3 - 2 * var(--t-cloud-l))
    );

    /* pin at turn */
    --kv-cloud-l-base: calc((var(--_kv-max) - var(--_kv-cloud-l-turn)) / 2);
    /* total recession */
    --kv-cloud-l-recede: calc(
      228px - (var(--_kv-cloud-l-turn) - var(--_kv-cloud-l-hide)) / 2
    );

    /* base translateX (pinned or receding) */
    --kv-cloud-x: min(
      calc(var(--t) * var(--kv-shrink)),
      calc(
        var(--kv-cloud-l-base) - var(--t-cloud-l-eased) *
          var(--kv-cloud-l-recede)
      )
    );
    transform: translateX(var(--kv-cloud-x));
  }

  /* cloud_r: right edge pinned to the frame's right edge -> move left --kv-shrink */
  .kv__cloud--r {
    --kv-cloud-x: calc(var(--t) * -1 * var(--kv-shrink));
    transform: translateX(var(--kv-cloud-x));

    animation-delay: calc(
      var(--_kv-cloud-swing-period) / -2
    ); /* anti-phase to cloud_l */
  }

  /* hikyaku: starts 80px left; moves up-right, exits by W = break */
  .kv__hikyaku {
    z-index: 2;
    transform: translateX(calc(-80px + var(--t) * 200px))
      translateY(calc(var(--t) * -80px));
  }

  /* onago: moves right; content left edge reaches --_kv-onago-x at W = break */
  .kv__onago {
    z-index: 3;
    transform: translateX(
      calc(var(--t) * (var(--_kv-onago-x) + var(--kv-shrink) - 130px))
    );
  }

  /* warabe: 50px left */
  .kv__warabe {
    z-index: 3;
    transform: translateX(-50px);
  }

  /* 1530px rectangle centered in the design space; scaleX to frame width at break */
  .kv__rectangle {
    --kv-left: calc((var(--_kv-max) - 1530px) / 2);
    --kv-width: 1530px;

    z-index: 4;
    transform-origin: center;
    transform: scaleX(calc(1 - var(--t) * (1 - var(--_kv-break) / 1530px)));
  }

  /* logo: follows the right edge together with cloud_r (no wiggle) */
  .kv__logo {
    z-index: 5;
    transform: translateX(calc(var(--t) * -1 * var(--kv-shrink)));
  }

  /* samurai: centered at W = break -> right 198.5px */
  .kv__samurai {
    z-index: 6;
    transform: translateX(calc(var(--t) * (var(--_kv-max) / 2 - 476.5px)));
  }
</style>
