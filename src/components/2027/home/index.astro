---
import { getIntlayer, type LocalesValues } from "intlayer";

import Layout from "../_layouts/Layout.astro";
import KeyVisual from "./key-visual/index.astro";
import Section1 from "./Section1.astro";
import Section2 from "./Section2.astro";

interface Props {
  locale: LocalesValues;
}
const { locale } = Astro.props;

const { title, description } = getIntlayer("2027-home", locale);
---

<Layout locale={locale} title={title} description={description} overlayHeader>
  <KeyVisual locale={locale} />
  <Section1 locale={locale} />
  <Section2 locale={locale} />
</Layout>
