---
import { getIntlayer, type LocalesValues } from "intlayer";

import Markdown from "../_common/Markdown.astro";
import PageBanner from "../_common/page-banner/index.astro";
import Layout from "../_layouts/Layout.astro";
import Section1 from "./Section1.astro";

interface Props {
  locale: LocalesValues;
}
const { locale } = Astro.props;

const { description, title } = getIntlayer("2027-cfp", locale);
---

<Layout locale={locale} title={title} description={description}>
  <PageBanner titleJa={["プロポーザル", "募集"]} titleEn="Call for Proposals" />
  <Section1 locale={locale}>
    <Markdown slug="cfp" locale={locale} />
  </Section1>
</Layout>
