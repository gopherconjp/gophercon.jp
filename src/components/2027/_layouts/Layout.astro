---
import { getHTMLTextDir, type LocalesValues } from "intlayer";

import Footer from "../_common/footer/index.astro";
import Header from "../_common/header/index.astro";
import OverlayHeader from "../_common/header/Overlay.astro";
import LocaleRedirector from "../../_common/LocaleRedirector.astro";
import { getOgLocale, getSeo } from "../../../utils/seo";

import "../_styles/token.css";
import "../_styles/font.css";
import "../_styles/elements.css";

interface Props {
  locale: LocalesValues;
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  type?: "website" | "article";
  overlayHeader?: boolean;
}
const {
  locale,
  title = "",
  description,
  ogImage = "/2027/ogp.png",
  ogImageAlt = "GopherCon Japan OGP",
  type = "website",
  overlayHeader = false,
} = Astro.props;

const SITE_NAME = "GopherCon Japan 2027";

const { fullTitle, ogImageUrl, ogLocale, canonical, alternates, xDefaultHref } =
  getSeo({
    locale,
    pathname: Astro.url.pathname,
    site: Astro.site,
    siteName: SITE_NAME,
    title,
    ogImage,
  });
---

<!doctype html>
<html lang={locale} dir={getHTMLTextDir(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FF7A65" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon/favicon-16x16.png"
    />
    <link rel="icon" href="/favicon/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    {
      alternates
        .filter((alt) => getOgLocale(alt.locale) !== ogLocale)
        .map((alt) => (
          <meta
            property="og:locale:alternate"
            content={getOgLocale(alt.locale)}
          />
        ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@GopherConJP" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.locale} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <LocaleRedirector />
  </head>
  <body id="top">
    {
      overlayHeader ? (
        <OverlayHeader locale={locale} />
      ) : (
        <Header locale={locale} />
      )
    }
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
