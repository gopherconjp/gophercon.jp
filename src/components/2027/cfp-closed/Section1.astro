---
import { getIntlayer, type LocalesValues } from "intlayer";

import Breakable from "../../_common/breakable/index.astro";
import ContentBox from "../../_common/content-box/index.astro";

interface Props {
  locale: LocalesValues;
}
const { locale } = Astro.props;

const { body, title } = getIntlayer("2027-cfp-closed-section1", locale);
---

<section class="cfp-closed-section1">
  <ContentBox variant="text">
    <div class="cfp-closed-section1__content">
      <h2 class="cfp-closed-section1__title">
        <Breakable value={title} space={locale !== "ja"} />
      </h2>
      <p class="cfp-closed-section1__body">
        <Breakable value={body} space={locale !== "ja"} />
      </p>
    </div>
  </ContentBox>
</section>

<style>
  .cfp-closed-section1__content {
    display: grid;
    gap: var(--_spacing-40);
    padding: var(--_spacing-64) 0;
    text-align: center;
  }

  .cfp-closed-section1__title {
    width: fit-content;
    max-width: 100%;
    justify-self: center;
    text-align: left;
  }

  .cfp-closed-section1__body {
    margin: 0;
  }
</style>
