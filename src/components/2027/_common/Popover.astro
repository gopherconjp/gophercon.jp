---
/**
 * Headless popover primitive.
 *
 * Opens on hover (and click), closes on outside click, Escape, or a second
 * click. Open state is exposed via `aria-expanded`.
 * No styles are applied — the consumer positions and styles the trigger and
 * content.
 *
 * Slots:
 *  - `trigger`: rendered inside the trigger button
 *  - `content`: rendered inside the popover wrapper; pass any element
 *    (e.g. an `<a>`) to make the whole area clickable
 */
interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<div class="popover" data-popover>
  <button
    type="button"
    class="popover__trigger"
    aria-label={label}
    aria-expanded="false"
    aria-controls={`${id}-content`}
    data-popover-trigger
  >
    <slot name="trigger" />
  </button>
  <div id={`${id}-content`} hidden data-popover-content>
    <slot name="content" />
  </div>
</div>

<script>
  document.querySelectorAll("[data-popover]").forEach((popover) => {
    const trigger = popover.querySelector("[data-popover-trigger]");
    const content = popover.querySelector("[data-popover-content]");
    if (!(trigger instanceof HTMLElement) || !(content instanceof HTMLElement))
      return;

    let isOpen = false;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    const setOpen = (open: boolean) => {
      if (open) {
        document.dispatchEvent(
          new CustomEvent("popover:close-others", {
            detail: { source: popover },
          }),
        );
      }

      isOpen = open;
      content.hidden = !open;
      trigger.setAttribute("aria-expanded", String(open));
    };

    // Close when another popover opens (only one visible at a time).
    document.addEventListener("popover:close-others", (event) => {
      const { source } = (event as CustomEvent).detail;
      if (source !== popover) setOpen(false);
    });

    const cancelClose = () => {
      clearTimeout(closeTimer);
      closeTimer = undefined;
    };

    trigger.addEventListener("click", () => {
      setOpen(!isOpen);
    });

    popover.addEventListener("mouseenter", () => {
      cancelClose();
      setOpen(true);
    });

    popover.addEventListener("mouseleave", (event) => {
      // Moving into the popover content: keep it open.
      const related = (event as MouseEvent).relatedTarget;
      if (related instanceof Node && popover.contains(related)) {
        return;
      }

      closeTimer = setTimeout(() => setOpen(false), 150);
    });

    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !popover.contains(event.target))
        setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen) {
        const restoreFocus = content.contains(document.activeElement);
        setOpen(false);
        if (restoreFocus) trigger.focus();
      }
    });
  });
</script>

<style>
  .popover {
    position: relative;
    display: inline-flex;
  }

  .popover__trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--_spacing-8);
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
</style>
