---
import { getIntlayer, getLocaleName, type LocalesValues } from "intlayer";

import Popover from "../../../../_common/Popover.astro";
import { getLocalizedHref, getOtherLocale } from "../../../../../utils/locale";

interface Props {
  locale: LocalesValues;
}
const { locale } = Astro.props;
const otherLocale = getOtherLocale(locale);

const { ariaLabel, switchTo } = getIntlayer(
  "2027-header-locale-switcher",
  locale,
);
---

<Popover id="locale-switcher" label={ariaLabel}>
  <span slot="trigger" class="locale-switcher__label">
    <span class="locale-switcher__label-prefix">Lang:</span>
    <span class="locale-switcher__label-name">{getLocaleName(locale)}</span>
    <span class="locale-switcher__caret" aria-hidden="true">▼</span>
  </span>

  <a
    slot="content"
    class="locale-switcher__item"
    href={getLocalizedHref(Astro.url.pathname, otherLocale)}
    data-locale={otherLocale}
  >
    <span class="locale-switcher__item-frame">{switchTo}</span>
  </a>
</Popover>

<script>
  import { setupLocalePersistence } from "../../../../../utils/locale";

  setupLocalePersistence();
</script>

<style>
  .locale-switcher__label {
    display: flex;
    align-items: flex-end;
    height: 24px;
    white-space: nowrap;
    font-size: var(--_font-size-body);
    font-weight: var(--_font-weight-bold);
    line-height: var(--_line-height-1);
    color: var(--_color-black);
  }

  .locale-switcher__label-prefix {
    font-weight: var(--_font-weight-regular);
    padding-bottom: 4px;
    margin-right: 6px;
  }

  .locale-switcher__label-name {
    position: relative;
    padding-bottom: 4px;
    margin-right: 6px;
  }

  .locale-switcher__label-name::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: var(--_border-width-2);
    background: var(--_color-dark);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .locale-switcher__caret {
    font-size: var(--_font-size-caret);
    line-height: var(--_line-height-1);
    color: var(--_color-dark);
    transition: transform 0.2s ease;
    transform: translateY(-6px);
  }

  .locale-switcher__label[data-popover-open] {
    & .locale-switcher__label-name::after {
      transform: scaleX(1);
    }

    & .locale-switcher__caret {
      transform: translateY(-6px) rotate(180deg);
    }
  }

  .locale-switcher__item {
    position: absolute;
    top: calc(100% + var(--_spacing-8));
    right: 0;
    z-index: 10;
    display: block;
    padding: var(--_spacing-16) var(--_spacing-24) var(--_spacing-12);
    background: var(--_color-white);
    border-radius: var(--_radius-8);
    box-shadow: var(--_shadow-popup);
    text-decoration: none;
  }

  .locale-switcher__item-frame {
    position: relative;
    display: block;
    height: 24px;
    padding-top: 4px;
    font-weight: var(--_font-weight-bold);
    line-height: var(--_line-height-1);
    color: var(--_color-black);
    white-space: nowrap;
  }
</style>
