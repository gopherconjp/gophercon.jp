---
import { Image } from "astro:assets";
import { getIntlayer, getLocalizedUrl, type LocalesValues } from "intlayer";

import logo from "../logo.webp";
import NavLink from "../nav-link/index.astro";
import Hamburger from "./content/Hamburger.astro";
import LocaleSwitcher from "./content/LocaleSwitcher.astro";

interface Props {
  locale: LocalesValues;
}
const { locale } = Astro.props;

const { navLabel, menuLabel } = getIntlayer("2027-header", locale);

const currentPath =
  Astro.url.pathname.length > 1
    ? Astro.url.pathname.replace(/\/$/, "")
    : Astro.url.pathname;

const links = [
  { label: "About", href: getLocalizedUrl("/2027/about", locale) },
].map((link) => Object.assign(link, { current: currentPath === link.href }));

const HEADER_BREAK_PX = 500; // desktop/mobile switch
const HEADER_COMPACT_MIN_PX = 440; // shrink start
---

<header class="header">
  <div class="header__left">
    <a href={getLocalizedUrl("/2027", locale)}>
      <Image
        src={logo}
        alt="GopherCon Japan 2027 logo"
        height={72}
        class="header__logo"
      />
    </a>
    <nav class="header__nav" aria-label={navLabel}>
      {links.map((link) => (
        <NavLink label={link.label} href={link.href} current={link.current} />
      ))}
    </nav>
  </div>
  <div class="header__right">
    <LocaleSwitcher locale={locale} />
    <span class="header__hamburger">
      <Hamburger label={menuLabel} links={links} />
    </span>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--_header-height);
    padding: 0 var(--_spacing-24);
    background: var(--_color-white);
  }

  .header__left {
    display: flex;
    align-items: center;
    gap: var(--_spacing-24);
  }

  .header__logo {
    display: block;
    margin-right: var(--_spacing-8);
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: var(--_spacing-24);
  }

  .header__right {
    display: flex;
    align-items: center;
    gap: var(--_spacing-16);
  }

  .header__hamburger {
    display: flex;
    align-items: center;
  }
</style>

<style
  set:html={`
  @media (min-width: ${HEADER_BREAK_PX}px) {
    .header__nav.header__nav { display: flex; }
    .header__hamburger.header__hamburger { display: none; }
  }

  @media (max-width: ${HEADER_COMPACT_MIN_PX}px) {
    .header.header { zoom: calc(100vw / ${HEADER_COMPACT_MIN_PX}px); }
  }
`}
></style>
