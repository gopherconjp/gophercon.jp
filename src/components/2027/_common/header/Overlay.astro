---
import type { LocalesValues } from "intlayer";

import Header from "./index.astro";

interface Props {
  locale: LocalesValues;
}
const { locale } = Astro.props;
---

<div class="overlay" data-header-overlay>
  <Header locale={locale} />
</div>
<div class="overlay__sentinel" data-header-sentinel aria-hidden="true"></div>

<script>
  const overlay = document.querySelector("[data-header-overlay]");
  const sentinel = document.querySelector("[data-header-sentinel]");

  if (overlay instanceof HTMLElement && sentinel) {
    let isPast = false;
    let isHover = false;

    const update = () => {
      overlay.classList.toggle("is-shown", isPast || isHover);
    };

    new IntersectionObserver(([entry]) => {
      isPast = !entry?.isIntersecting;
      update();
    }).observe(sentinel);

    document.addEventListener("mousemove", (event) => {
      isHover = event.clientY < overlay.offsetHeight;
      update();
    });

    document.documentElement.addEventListener("mouseleave", () => {
      isHover = false;
      update();
    });
  }
</script>

<style>
  .overlay {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transform: translateY(-100%);
    visibility: hidden;
    transition:
      transform 0.3s ease,
      visibility 0.3s;
  }

  .overlay.is-shown,
  .overlay:has([data-popover-content]:not([hidden])) {
    transform: none;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .overlay {
      transition: none;
    }
  }

  .overlay__sentinel {
    height: 1px;
  }
</style>
