---
import ContentBox from "../../../_common/content-box/index.astro";

interface Props {
  titleJa: string;
  titleEn: string;
}
const { titleJa, titleEn } = Astro.props;
---

<div class="page-banner">
  <ContentBox>
    <div class="page-banner__static">
      <p class="page-banner__title-ja">{titleJa}</p>
      <h1 class="page-banner__title-en">{titleEn}</h1>
    </div>
  </ContentBox>

  <div class="page-banner__viewport" aria-hidden="true">
    <div class="page-banner__track">
      <div class="page-banner__group">
        <p class="page-banner__title-ja">{titleJa}</p>
        <p class="page-banner__title-en">{titleEn}</p>
      </div>
      <div class="page-banner__group">
        <p class="page-banner__title-ja">{titleJa}</p>
        <p class="page-banner__title-en">{titleEn}</p>
      </div>
    </div>
  </div>
</div>

<script>
  const SPEED = 120;
  const GAP = 96;

  const update = (banner: HTMLElement): void => {
    const content = banner.querySelector(".page-banner__static");
    const group = banner.querySelector(
      ".page-banner__viewport .page-banner__group",
    );
    if (!content || !group) return;

    const titles = content.querySelectorAll("p, h1");
    const overflow = Array.from(titles).some(
      (title) => title.scrollWidth > content.clientWidth + 1,
    );
    banner.classList.toggle("page-banner--marquee", overflow);

    if (overflow) {
      const distance = group.getBoundingClientRect().width + GAP;
      banner.style.setProperty(
        "--page-banner-duration",
        `${distance / SPEED}s`,
      );
    } else {
      banner.style.removeProperty("--page-banner-duration");
    }
  };

  const init = (): void => {
    const banners = document.querySelectorAll<HTMLElement>(".page-banner");
    for (const banner of banners) {
      update(banner);

      if ("ResizeObserver" in window) {
        new ResizeObserver(() => update(banner)).observe(banner);
      }
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }

  if (document.fonts?.ready) {
    document.fonts.ready.then(() => {
      for (const banner of document.querySelectorAll<HTMLElement>(
        ".page-banner",
      ))
        update(banner);
    });
  }
</script>

<style>
  .page-banner {
    position: relative;
    background: var(--_color-light);
  }

  .page-banner__static {
    display: grid;
    gap: var(--_spacing-32);
    overflow: clip;
    padding: var(--_spacing-64) 0;
  }

  .page-banner__viewport {
    position: absolute;
    inset: 0;
    display: none;
    overflow: clip;
    align-content: center;
  }

  .page-banner--marquee .page-banner__static {
    opacity: 0;
  }

  .page-banner--marquee .page-banner__viewport {
    display: grid;
  }

  .page-banner__track {
    display: flex;
    gap: var(--_spacing-96);
    width: max-content;
    animation: page-banner-scroll var(--page-banner-duration, 20s) linear
      infinite;
  }

  .page-banner__group {
    display: grid;
    flex: 0 0 auto;
    gap: var(--_spacing-32);
  }

  @keyframes page-banner-scroll {
    to {
      transform: translateX(calc(-50% - var(--_spacing-48)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-banner--marquee .page-banner__static {
      opacity: 1;
      overflow: visible;
    }

    .page-banner--marquee .page-banner__viewport {
      display: none;
    }

    .page-banner--marquee .page-banner__title-ja,
    .page-banner--marquee .page-banner__title-en {
      white-space: normal;
    }

    .page-banner--marquee .page-banner__track {
      animation: none;
    }
  }

  .page-banner__title-ja,
  .page-banner__title-en {
    margin: 0;
    color: var(--_color-black);
    font-weight: var(--_font-weight-bold);
    text-align: left;
    white-space: nowrap;
  }

  .page-banner__title-ja {
    font-size: var(--_font-size-h2);
    line-height: var(--_line-height-1-5);
  }

  .page-banner__title-en {
    font-size: var(--_font-size-banner);
    line-height: var(--_line-height-1);
  }
</style>
