---
import { Image } from "astro:assets";
import { getIntlayer, type LocalesValues } from "intlayer";

import ContentBox from "../../../_common/content-box/index.astro";
import logo from "../logo.webp";
import NavLink from "../nav-link/index.astro";

interface Props {
  locale: LocalesValues;
}
const { locale } = Astro.props;

const { backToTop, copyright, credit, logoAlt } = getIntlayer(
  "2027-footer",
  locale,
);

const FOOTER_BREAK_PX = 820;
const FOOTER_COMPACT_MIN_PX = 440;
---

<footer class="footer">
  <ContentBox>
    <div slot="background" class="footer__background"></div>

    <div class="footer__row">
      <Image src={logo} alt={logoAlt} height={72} class="footer__logo" />
      <div class="footer__texts">
        <p class="footer__body">
          {copyright}
          <br />
          {credit}
        </p>
      </div>
      <div class="footer__top">
        <NavLink href="#top">{backToTop}</NavLink>
      </div>
    </div>
  </ContentBox>
</footer>

<style>
  .footer {
    position: relative;
  }

  .footer__background {
    height: 100%;
    background: var(--_color-light);
  }

  .footer__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "logo texts top";
    align-items: start;
    column-gap: var(--_spacing-24);
    row-gap: var(--_spacing-8);
    padding: var(--_spacing-16) 0;
  }

  .footer__logo {
    grid-area: logo;
    display: block;
  }

  .footer__texts {
    grid-area: texts;
    align-self: end;
    margin-bottom: var(--_spacing-8);
  }

  .footer__top {
    grid-area: top;
    display: flex;
    align-self: start;
    justify-self: end;
    margin-top: var(--_spacing-8);
  }

  .footer__body {
    margin: 0;
    font-size: var(--_font-size-small);
  }
</style>

<style
  set:html={`
  @media (max-width: ${FOOTER_BREAK_PX - 1}px) {
    .footer__row.footer__row {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "logo top"
        "texts texts";
      align-items: start;
    }
    .footer__texts.footer__texts {
      margin-bottom: 0;
    }
  }

  @media (max-width: ${FOOTER_COMPACT_MIN_PX}px) {
    .footer.footer { zoom: calc(100vw / ${FOOTER_COMPACT_MIN_PX}px); }
  }
`}
></style>
