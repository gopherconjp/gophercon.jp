---
import Card from "./index.astro";

interface CardItem {
  label: string;
  content: string;
}

interface Props {
  cards: CardItem[];
}
const { cards } = Astro.props;
---

<div class="card-list">
  {
    cards.map((card: CardItem) => (
      <Card label={card.label} content={card.content} />
    ))
  }
</div>

<style>
  .card-list {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--_spacing-32);
    row-gap: 0;
  }

  .card-list > :global(.card) {
    flex: 0 0 auto;
    width: auto;
  }
</style>
