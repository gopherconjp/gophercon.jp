---
import Card from "./index.astro";

interface CardItem {
  label: string;
  content: string;
  body?: string;
  dark?: boolean;
}

interface Props {
  cards: CardItem[];
}
const { cards } = Astro.props;
---

<div class="card-list">
  {cards.map((card: CardItem) => (
    <Card
      label={card.label}
      content={card.content}
      body={card.body}
      dark={card.dark}
    />
  ))}
</div>

<style>
  .card-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: start;
    column-gap: var(--_spacing-32);
    row-gap: var(--_spacing-32);
  }

  .card-list > :global(.card) {
    flex: 0 0 auto;
    width: auto;
  }
</style>
