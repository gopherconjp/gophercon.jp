---
import type { LocalesValues } from "intlayer";

import type { Breakable } from "../../../_common/breakable/types";
import Card from "./index.astro";

interface CardItem {
  label: string;
  content: Breakable;
  body?: Breakable;
  dark?: boolean;
}

interface Props {
  locale: LocalesValues;
  cards: CardItem[];
}
const { locale, cards } = Astro.props;
---

<div class="card-list">
  {cards.map((card: CardItem) => (
    <Card
      locale={locale}
      label={card.label}
      content={card.content}
      body={card.body}
      dark={card.dark}
    />
  ))}
</div>

<style>
  .card-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: start;
    gap: var(--_spacing-32) var(--_spacing-32);
  }

  .card-list > :global(.card) {
    flex: 0 0 auto;
    width: auto;
  }
</style>
