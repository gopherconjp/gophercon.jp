---
import type { LocalesValues } from "intlayer";

import Breakable from "../../../_common/breakable/index.astro";
import type { Breakable as BreakableValue } from "../../../_common/breakable/types";

interface Props {
  locale: LocalesValues;
  label: string;
  content: BreakableValue;
  body?: BreakableValue;
  dark?: boolean;
}
const { locale, label, content, body, dark = false } = Astro.props;
---

<div class:list={["card", dark && "card--dark"]}>
  <h2 class="center">{label}</h2>
  <div class="card__body-group">
    <p class="card__content">
      <Breakable value={content} space={locale !== "ja"} />
    </p>
    {body && (
      <p class="card__body">
        <Breakable value={body} space={locale !== "ja"} />
      </p>
    )}
  </div>
</div>

<style>
  .card {
    box-sizing: border-box;
    display: grid;
    justify-items: center;
    gap: var(--_spacing-24);
    padding: 0 var(--_spacing-32);
    width: max-content;
    max-width: 100%;
  }

  .card h2 {
    width: 168px;
    max-width: 100%;
  }

  .card__body-group {
    display: grid;
    justify-items: center;
    gap: var(--_spacing-4);
    width: 100%;
  }

  .card__content,
  .card__body {
    margin: 0;
    width: max-content;
    max-width: 100%;
    min-width: min(168px, 100%);
    text-align: center;
  }

  .card--dark,
  .card--dark h2,
  .card--dark p {
    color: var(--_color-white);
  }

  .card__content {
    font-weight: var(--_font-weight-bold);
    font-size: var(--_font-size-h3);
  }
</style>
