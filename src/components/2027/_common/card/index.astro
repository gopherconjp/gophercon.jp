---
interface Props {
  label: string;
  content: string;
  body?: string;
}
const { label, content, body } = Astro.props;
---

<div class="card">
  <h2 class="center">{label}</h2>
  <div class="card__body-group">
    <p class="card__content">{content}</p>
    {body && <p class="card__body">{body}</p>}
  </div>
</div>

<style>
  .card {
    box-sizing: border-box;
    display: grid;
    justify-items: center;
    gap: var(--_spacing-16);
    padding: var(--_spacing-32);
    width: max-content;
    max-width: 100%;
  }

  .card h2 {
    width: 168px;
    max-width: 100%;
  }

  .card__body-group {
    display: grid;
    justify-items: center;
    gap: var(--_spacing-4);
    width: 100%;
  }

  .card__content,
  .card__body {
    margin: 0;
    width: max-content;
    max-width: 100%;
    min-width: min(168px, 100%);
    text-align: center;
  }

  .card__content {
    font-weight: var(--_font-weight-bold);
    font-size: var(--_font-size-h3);
    line-height: var(--_line-height-1-6);
  }
</style>
