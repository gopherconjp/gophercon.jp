---
interface Props {
  label: string;
  content: string;
}
const { label, content } = Astro.props;
---

<div class="card">
  <h2 class="center">{label}</h2>
  <p class="card__content">{content}</p>
</div>

<style>
  .card {
    box-sizing: border-box;
    display: grid;
    justify-items: center;
    gap: var(--_spacing-16);
    padding: var(--_spacing-32);
    width: max-content;
    max-width: 100%;
  }

  .card h2 {
    width: 168px;
    max-width: 100%;
  }

  .card__content {
    margin: 0;
    width: max-content;
    max-width: 100%;
    min-width: min(168px, 100%);
    font-family: var(--_font-family-bizter);
    font-weight: var(--_font-weight-bold);
    font-size: var(--_font-size-h3);
    line-height: var(--_line-height-1-6);
    color: var(--_color-black);
    letter-spacing: 0;
    text-align: center;
  }
</style>
