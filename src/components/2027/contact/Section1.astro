---
import { getIntlayer, type LocalesValues } from "intlayer";

import Breakable from "../../_common/breakable/index.astro";
import ContentBox from "../../_common/content-box/index.astro";
import SocialCard from "./cards/SocialCard.astro";
import { socials } from "./socials";

interface Props {
  locale: LocalesValues;
}
const { locale } = Astro.props;

const { title } = getIntlayer("2027-contact-section1", locale);
---

<section class="contact-section1">
  <ContentBox variant="text">
    <div class="contact-section1__content">
      <h2 class="contact-section1__title center">
        <Breakable value={title} locale={locale} />
      </h2>
      <div class="contact-section1__cards">
        {socials.map((social) => (
          <SocialCard locale={locale} social={social} />
        ))}
      </div>
    </div>
  </ContentBox>
</section>

<style>
  .contact-section1__content {
    display: grid;
    gap: var(--_spacing-40);
    padding: var(--_spacing-64) 0;
    text-align: center;
  }

  .contact-section1__title {
    width: fit-content;
    max-width: 100%;
    justify-self: center;
    text-align: left;
  }

  .contact-section1__cards {
    display: grid;
    gap: var(--_spacing-40);
  }
</style>
