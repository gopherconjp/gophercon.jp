---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getIntlayer, type LocalesValues } from "intlayer";

import NavLink from "../../_common/nav-link/index.astro";
import { slack } from "../socials";

interface Props {
  locale: LocalesValues;
}
const { locale } = Astro.props;

const { join } = getIntlayer("2027-contact-slack-card", locale);
---

<div class="social-card">
  <a
    class="social-card__info"
    href={slack.href}
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="social-card__icon">
      <Image
        src={slack.logo}
        alt={slack.logoAlt}
        width={40}
        height={40}
        class="social-card__logo social-card__logo--default"
      />
      <Image
        src={slack.logoHover}
        alt=""
        aria-hidden="true"
        width={40}
        height={40}
        class="social-card__logo social-card__logo--hover"
      />
    </span>
    <span class="social-card__text-col">
      <span class="social-card__name">{slack.name}</span>
      <span class="social-card__handle">{slack.handle}</span>
    </span>
  </a>
  <div class="social-card__actions">
    <NavLink href={slack.joinHref} external>
      <span class="social-card__action-icon" aria-hidden="true">
        <Icon name="mdi:account-plus" />
      </span>
      {join}
    </NavLink>
  </div>
</div>

<style>
  .social-card {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: var(--_spacing-24);
    padding: var(--_spacing-24);
    width: 100%;
    background: var(--_color-white);
    border-radius: var(--_radius-8);
  }

  .social-card:hover {
    box-shadow: var(--_shadow-popup);
  }

  .social-card__info {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: var(--_spacing-32);
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .social-card__icon {
    position: relative;
    display: block;
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
  }

  .social-card__logo {
    display: block;
  }

  .social-card__logo--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .social-card:hover .social-card__logo--hover {
    opacity: 1;
  }

  .social-card:hover .social-card__logo--default {
    opacity: 0;
  }

  .social-card__text-col {
    display: grid;
    gap: 0;
    min-width: 0;
    justify-items: start;
    text-align: left;
  }

  .social-card__name {
    margin: 0;
    font-weight: var(--_font-weight-bold);
    font-size: var(--_font-size-body);
    line-height: var(--_line-height-1-8);
  }

  .social-card__handle {
    margin: 0;
    font-size: var(--_font-size-body);
    line-height: var(--_line-height-1-8);
  }

  .social-card__actions {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--_spacing-8) var(--_spacing-24);
  }

  .social-card__actions :global(.nav-link__label) {
    display: inline-flex;
    align-items: center;
    gap: var(--_spacing-8);
  }

  .social-card__action-icon {
    display: inline-flex;
    flex: 0 0 auto;
  }

  .social-card__action-icon :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
