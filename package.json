{
  "name": "gophercon.jp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "init": "bun scripts/setup-hooks.ts",
    "dev": "astro dev",
    "build": "astro build",
    "build:dev": "bun run build && bun run build:storybook",
    "preview": "astro preview",
    "preview:cf": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "deploy:dev": "astro build && wrangler deploy --env dev",
    "check": "astro check && tsc --noEmit && knip",
    "lint:ox": "oxlint --fix-dangerously",
    "lint:eslint": "eslint --fix \"src/**/*.astro\"",
    "lint:stylelint": "stylelint --fix \"src/**/*.css\" \"src/**/*.astro\"",
    "lint": "bun run lint:eslint && bun run lint:ox && bun run lint:stylelint",
    "format:ox": "oxfmt --write",
    "format:prettier": "prettier --write \"src/**/*.astro\"",
    "format": "bun run format:prettier && bun run format:ox",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o dist/storybook && bun run scripts/storybook/prepare-dist.ts",
    "penpot": "bun design/scripts/up.ts",
    "penpot:export": "bun design/scripts/export.ts",
    "penpot:import": "bun design/scripts/import.ts",
    "penpot:down": "bun design/scripts/down.ts",
    "penpot:reset": "bun design/scripts/reset.ts",
    "penpot:mcp": "bun design/scripts/mcp.ts"
  },
  "dependencies": {
    "@iconify-json/mdi": "1.2.3",
    "@intlayer/core": "9.5.8",
    "astro": "7.3.5",
    "astro-compress": "2.4.3",
    "astro-icon": "1.2.0",
    "astro-intlayer": "9.5.8",
    "html-escaper": "3.0.3",
    "intlayer": "9.5.8",
    "lightningcss-plugin-css-variables": "0.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@storybook-astro/framework": "1.12.0",
    "@storybook/builder-vite": "10.6.0",
    "@stylistic/stylelint-config": "5.0.0",
    "@types/bun": "1.4.2",
    "@types/html-escaper": "3.0.4",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "knip": "6.38.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright-core": "1.63.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.0.0",
    "storybook": "10.6.0",
    "stylelint": "17.15.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "wrangler": "4.138.0"
  }
}
