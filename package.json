{
  "name": "gophercon.jp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:cf": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check && tsc --noEmit",
    "lint:ox": "oxlint --fix",
    "lint:eslint": "eslint --fix \"src/**/*.astro\"",
    "lint": "bun run lint:eslint && bun run lint:ox",
    "format:ox": "oxfmt --write",
    "format:prettier": "prettier --write \"src/**/*.astro\"",
    "format": "bun run format:prettier && bun run format:ox",
    "storybook": "NODE_OPTIONS=--disable-warning=DEP0205 storybook dev -p 6006",
    "build-storybook": "NODE_OPTIONS=--disable-warning=DEP0205 storybook build"
  },
  "dependencies": {
    "astro": "7.2.9",
    "astro-intlayer": "9.4.1",
    "intlayer": "9.4.1",
    "lightningcss-plugin-css-variables": "0.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@storybook-astro/framework": "1.11.0",
    "@storybook/builder-vite": "10.5.10",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "storybook": "10.5.10",
    "typescript": "6.0.3",
    "wrangler": "4.127.1"
  }
}
