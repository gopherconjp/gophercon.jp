{
  "name": "gophercon.jp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bun install",
    "dev": "astro dev",
    "prebuild": "bun install",
    "build": "astro build",
    "build:dev": "bun run build && bun run build:storybook",
    "prepreview": "bun install",
    "preview": "astro preview",
    "prepreview:cf": "bun install",
    "preview:cf": "wrangler dev",
    "predeploy": "bun install",
    "deploy": "astro build && wrangler deploy",
    "precheck": "bun install",
    "check": "astro check && tsc --noEmit && knip",
    "prelint:ox": "bun install",
    "lint:ox": "oxlint --fix-dangerously",
    "prelint:eslint": "bun install",
    "lint:eslint": "eslint --fix \"src/**/*.astro\"",
    "lint": "bun run lint:eslint && bun run lint:ox",
    "preformat:ox": "bun install",
    "format:ox": "oxfmt --write",
    "preformat:prettier": "bun install",
    "format:prettier": "prettier --write \"src/**/*.astro\"",
    "format": "bun run format:prettier && bun run format:ox",
    "prestorybook": "bun install",
    "storybook": "storybook dev -p 6006",
    "prebuild:storybook": "bun install",
    "build:storybook": "storybook build -o dist/storybook && bun run scripts/storybook/prepare-dist.ts",
    "penpot": "bun design/scripts/up.ts",
    "penpot:export": "bun design/scripts/export.ts",
    "penpot:import": "bun design/scripts/import.ts",
    "penpot:down": "bun design/scripts/down.ts",
    "penpot:reset": "bun design/scripts/reset.ts",
    "penpot:mcp": "bun design/scripts/mcp.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@iconify-json/mdi": "1.2.3",
    "@intlayer/core": "9.5.3",
    "@storybook-astro/framework": "1.12.0",
    "@storybook/builder-vite": "10.6.0",
    "@types/bun": "1.4.2",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "astro": "7.3.3",
    "astro-compress": "2.4.3",
    "astro-icon": "1.2.0",
    "astro-intlayer": "9.5.3",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.2.1",
    "intlayer": "9.5.3",
    "knip": "6.36.0",
    "lightningcss-plugin-css-variables": "0.1.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.0",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "wrangler": "4.134.0"
  }
}
